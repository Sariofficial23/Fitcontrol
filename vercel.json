{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "cd miniapp && npm ci",
  "buildCommand": "cd miniapp && npm run build",
  "outputDirectory": "miniapp/dist",
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "backend/**",
      "excludeFiles": "{backend/tests/**,miniapp/**,docs/**,**/__pycache__/**}"
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index" },
    { "source": "/health", "destination": "/api/index" },
    { "source": "/:path*", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/v1/ops/cron/notifications", "schedule": "0 4 * * *" }
  ]
}
